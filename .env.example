MONGODB_URI=
JWT_SECRET=
# From aistudio.google.com -> Get API key. Server-side only: it is
# never sent to the browser, and never committed. The quota belongs to
# the Google project behind the key, so keep your own.
GEMINI_API_KEY=
PORT=4000
# Comma-separated origins allowed to call the API from a browser.
# Local: http://localhost:5173   Deployed: https://<your-frontend>.vercel.app
CORS_ORIGIN=http://localhost:5173
